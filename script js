// CONTROLE DE NAVEGAÇÃO POR ABAS
function abrirAba(evento, idAba) {
  const conteudos = document.querySelectorAll('.aba-conteudo');
  conteudos.forEach(conteudo => conteudo.classList.remove('ativa'));

  const botoes = document.querySelectorAll('.aba-btn');
  botoes.forEach(botao => botao.classList.remove('ativa'));

  document.getElementById(idAba).classList.add('ativa');
  evento.currentTarget.classList.add('ativa');
}

// CONTROLE DAS SUB-ABAS DE GOLPES
function abrirSubAba(evento, idSubAba) {
  const conteudos = document.querySelectorAll('.sub-aba-conteudo');
  conteudos.forEach(conteudo => conteudo.classList.remove('ativa'));

  const botoes = document.querySelectorAll('.sub-aba-btn');
  botoes.forEach(botao => botao.classList.remove('ativa'));

  document.getElementById(idSubAba).classList.add('ativa');
  evento.currentTarget.classList.add('ativa');
}

// LÓGICA DA LUPA (AMPLIAR E VOLTAR AO NORMAL)
let tamanhoAtual = 32; // Tamanho base
const tamanhoPadrao = 32;
const tamanhoMaximo = 64;

const textoLupa = document.getElementById('textoLupa');
const resultadoLupa = document.getElementById('resultadoLupa');

function atualizarLupa() {
  const texto = textoLupa.value.trim();
  resultadoLupa.style.fontSize = `${tamanhoAtual}px`;

  if (texto !== "") {
    resultadoLupa.textContent = texto;
  } else {
    resultadoLupa.textContent = "O texto ampliado aparecerá aqui.";
  }
}

function ampliarTexto() {
  if (tamanhoAtual < tamanhoMaximo) {
    tamanhoAtual += 6;
    atualizarLupa();
  }
}

function restaurarTexto() {
  tamanhoAtual = tamanhoPadrao;
  atualizarLupa();
}

textoLupa.addEventListener('input', atualizarLupa);


// LÓGICA DO VERIFICADOR DE GOLPES
function verificarGolpe() {
  const mensagem = document.getElementById('textoGolpe').value.toLowerCase().trim();
  const resultadoDiv = document.getElementById('resultadoGolpe');

  if (mensagem === "") {
    alert("Por favor, cole uma mensagem antes de clicar no botão.");
    return;
  }

  const palavrasSuspeitas = [
    "pix", "urgente", "bloqueado", "bloqueio", "senha", "banco", 
    "transferência", "premio", "prêmio", "sorteio", "clique no link", 
    "recadastramento", "atualize", "código", "verificação", "filho", 
    "mãe", "pai", "preciso de dinheiro", "número novo"
  ];

  const encontradas = palavrasSuspeitas.filter(palavra => mensagem.includes(palavra));

  resultadoDiv.classList.remove('hidden');

  if (encontradas.length > 0) {
    resultadoDiv.className = "caixa-resposta alerta-perigo";
    resultadoDiv.innerHTML = `
      <h3>⚠️ ATENÇÃO: ESTA MENSAGEM PODE SER UM GOLPE!</h3>
      <p><strong>Termos suspeitos identificados:</strong> ${encontradas.join(', ')}.</p>
      <br>
      <p>💡 <strong>Dicas de proteção:</strong></p>
      <ul>
        <li>Não faça PIX nem envie dinheiro.</li>
        <li>Não clique em links.</li>
        <li>Ligue para o parente ou banco no número antigo/oficial.</li>
      </ul>
    `;
  } else {
    resultadoDiv.className = "caixa-resposta alerta-seguro";
    resultadoDiv.innerHTML = `
      <h3>✅ Nenhum termo suspeito comum foi encontrado.</h3>
      <p>Mesmo assim, lembre-se: bancos e parentes não pedem senhas ou códigos por mensagem!</p>
    `;
  }
}