// CONTROLE DE NAVEGAÇÃO
function mudarAba(evento, idAba) {
  document.querySelectorAll('.aba-conteudo').forEach(aba => aba.classList.remove('ativa'));
  document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('ativa'));

  document.getElementById(idAba).classList.add('ativa');
  evento.currentTarget.classList.add('ativa');
}

// LÚPA E CONTROLE DE FONTE
let tamanhoFonte = 32;
const textoEntrada = document.getElementById('textoEntrada');
const textoAmpliado = document.getElementById('textoAmpliado');

function atualizarDisplay() {
  const texto = textoEntrada.value.trim();
  textoAmpliado.style.fontSize = `${tamanhoFonte}px`;
  textoAmpliado.textContent = texto !== "" ? texto : "O seu texto aparecerá aqui...";
}

function alterarTamanho(variacao) {
  if (tamanhoFonte + variacao >= 20 && tamanhoFonte + variacao <= 72) {
    tamanhoFonte += variacao;
    atualizarDisplay();
  }
}

textoEntrada.addEventListener('input', atualizarDisplay);

// LEITURA POR VOZ (SÍNTESE DE VOZ DA WEB)
function ouvirTexto() {
  const texto = textoEntrada.value.trim();
  if (texto === "") {
    alert("Digite um texto antes de clicar em ouvir.");
    return;
  }

  window.speechSynthesis.cancel(); // Para leituras anteriores
  const mensagem = new SpeechSynthesisUtterance(texto);
  mensagem.lang = 'pt-BR';
  mensagem.rate = 0.9; // Velocidade levemente reduzida para idosos
  window.speechSynthesis.speak(mensagem);
}

function pararVoz() {
  window.speechSynthesis.cancel();
}

// VERIFICADOR DE GOLPES
function analisarGolpe() {
  const mensagem = document.getElementById('textoAnalisar').value.toLowerCase().trim();
  const painel = document.getElementById('painelResultado');

  if (mensagem === "") {
    alert("Por favor, digite ou cole a mensagem para analisar.");
    return;
  }

  const palavrasSuspeitas = [
    "pix", "urgente", "bloqueado", "bloqueio", "senha", "banco", 
    "transferência", "premio", "prêmio", "sorteio", "clique no link", 
    "recadastramento", "atualize", "código", "verificação", "filho", 
    "mãe", "pai", "preciso de dinheiro", "número novo"
  ];

  const encontradas = palavrasSuspeitas.filter(palavra => mensagem.includes(palavra));
  painel.classList.remove('hidden');

  if (encontradas.length > 0) {
    painel.className = "resultado-analise alerta-perigo";
    painel.innerHTML = `
      <h3>⚠️ ATENÇÃO: POSSÍVEL GOLPE DETECTADO!</h3>
      <p>Termos de risco identificados: <strong>${encontradas.join(', ')}</strong></p>
      <br>
      <p><strong>Orientação:</strong> Não faça pagamentos nem envie dados. Ligue diretamente para a pessoa ou instituição para confirmar.</p>
    `;
  } else {
    painel.className = "resultado-analise alerta-seguro";
    painel.innerHTML = `
      <h3>✅ Nenhum termo suspeito evidente foi encontrado.</h3>
      <p>Mantenha a atenção: nunca compartilhe senhas ou códigos recebidos por SMS.</p>
    `;
  }
}

// SISTEMA DE SIMULAÇÃO GMAIL
function abrirModalGmail() {
  document.getElementById('modalGmail').classList.remove('hidden');
}

function fecharModalGmail() {
  document.getElementById('modalGmail').classList.add('hidden');
}

function salvarGmail() {
  const email = document.getElementById('inputEmail').value.trim();
  if (email !== "" && email.includes('@')) {
    document.querySelector('.btn-gmail').classList.add('hidden');
    const usuarioDiv = document.getElementById('usuarioLogado');
    document.getElementById('emailExibido').textContent = `👤 ${email}`;
    usuarioDiv.classList.remove('hidden');
    fecharModalGmail();
  } else {
    alert("Digite um e-mail válido.");
  }
}

function deslogarGmail() {
  document.querySelector('.btn-gmail').classList.remove('hidden');
  document.getElementById('usuarioLogado').classList.add('hidden');
  document.getElementById('inputEmail').value = "";
}